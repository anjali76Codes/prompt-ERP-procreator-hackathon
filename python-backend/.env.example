# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Auth bridge to the Node backend --------------------------------------
# Must match JWT_SECRET in express-backend/.env so this service can verify
# JWTs issued by the Node auth server.
JWT_SECRET=replace-with-the-same-secret-as-node-backend
JWT_ALGORITHM=HS256

# --- Node backend (for callouts: read user, post results, etc.) -----------
# The Express backend listens on :3000 (express-backend/.env -> PORT=3000).
NODE_API_URL=http://localhost:3000/api

# --- Google Gemini --------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.1

# --- MCP ------------------------------------------------------------------
# Optional comma-separated list of MCP server entries to load on startup.
# Example: erp=stdio://python -m app.mcp.servers.erp
MCP_SERVERS=

# --- WhatsApp (n8n webhook bridge) ----------------------------------------
# n8n webhook that forwards {to, message} JSON to WhatsApp.
WHATSAPP_WEBHOOK_URL=http://98.89.30.17:5678/webhook/whatsapp-message
# Single recipient for the demo — every send_whatsapp_message call uses this.
WHATSAPP_DEFAULT_TO=whatsapp:+918767902526

# --- Vapi (outbound voice calls) ------------------------------------------
# Vapi's REST API base — almost never needs changing.
VAPI_BASE_URL=https://api.vapi.ai
# Private API key (Bearer auth on POST /call).
VAPI_API_KEY=
# Pre-configured assistant that handles the call script.
VAPI_ASSISTANT_ID=
# Vapi-managed phone number to dial OUT from.
VAPI_PHONE_NUMBER_ID=
# E.164 number to dial — every make_reminder_call lands here.
VAPI_DEFAULT_TO=+918767902526
