# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Auth bridge to the Node backend --------------------------------------
# Must match JWT_SECRET in express-backend/.env so this service can verify
# JWTs issued by the Node auth server.
JWT_SECRET=replace-with-the-same-secret-as-node-backend
JWT_ALGORITHM=HS256

# --- Node backend (for callouts: read user, post results, etc.) -----------
# The Express backend listens on :3000 (express-backend/.env -> PORT=3000).
NODE_API_URL=http://localhost:3000/api

# --- Google Gemini --------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.1

# --- MCP ------------------------------------------------------------------
# Optional comma-separated list of MCP server entries to load on startup.
# Example: erp=stdio://python -m app.mcp.servers.erp
MCP_SERVERS=
